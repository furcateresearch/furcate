# Target-independent settings. Chip-specific ones are in sdkconfig.defaults.<target>.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Wi-Fi station only, started when the operator has configured it.
# No Bluetooth, no SoftAP, no listening services of any kind.
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_MAX_SOCKETS=4
# SNTP from the cell's head, then pool.ntp.org (fl_gateway.c).
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# UART interrupt runs during flash writes (OTA, models) too.
CONFIG_UART_ISR_IN_IRAM=y
