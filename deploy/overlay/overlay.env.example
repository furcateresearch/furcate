# /etc/furcate/overlay.env -- this node's overlay names and paths.
#
# Read by furcate-names, furcate-names-link, furcate-path and furcate-ssh. Copy
# to /etc/furcate/overlay.env and fill in; nothing reads this example.

# The site's zone label: members resolve as <name>.<site>.internal. Lower-case
# letters, digits and inner hyphens. The same on every node of the site.
FURCATE_OVERLAY_SITE=

# This node's fur0 address (with or without /prefix). furcate-names answers on
# port 53 of it, and furcate-names-link routes the zone to it.
FURCATE_OVERLAY_ADDR=

# Optional: this node's id (furcate:node:...), so it also resolves under its
# id-derived label on itself. Peers learn every member's id from its hint.
#FURCATE_OVERLAY_NODE_ID=

# Optional: the peer set to answer from. The agent writes it here by default.
#FURCATE_OVERLAY_PEERS=/var/lib/furcate/wg-plan-peers.json
