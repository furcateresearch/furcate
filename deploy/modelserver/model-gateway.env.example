# Configuration of furcate-model-router.service and furcate-model-gateway.service.
# `furcatectl model gateway` writes /etc/furcate/model-gateway.env (owner root,
# mode 0644: it holds no secret; the credential is /var/lib/furcate/models/
# gateway.token, root only). The services do not start without it. Written by
# hand it must state every line, since no value is assumed.

# Where the door listens. 0.0.0.0 relies on the node firewall to limit 8750 to
# the overlay and the LAN interfaces it names; 127.0.0.1 keeps it on this
# machine.
FURCATE_MODEL_BIND=127.0.0.1

# Models resident at once, context size in tokens, CPU threads.
FURCATE_MODEL_MAX=2
FURCATE_MODEL_CONTEXT=8192
FURCATE_MODEL_THREADS=3

# Layers offloaded to the accelerator. 0 is the CPU, a decision the operator
# makes by naming it (`furcatectl model gateway --cpu`), not a fallback.
FURCATE_MODEL_GPU_LAYERS=0

# on, off or auto.
FURCATE_MODEL_REASONING=auto
