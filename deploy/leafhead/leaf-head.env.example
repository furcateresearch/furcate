# Configuration of furcate-leaf-head.service. Copy to /etc/furcate/leaf-head.env
# (owner root, mode 0644: it holds no secret) and fill in every line. The
# service does not start without the file. The node signature is the firmware
# broker's (the unit passes --signer broker:); nothing here selects a signer.

# Where the leaf dials in.
# The firewall limits 7781 to the leaf-link interfaces, and the unit to end0 and
# wlan0, so the wildcard address follows the interface address across DHCP.
FL_LINK=listen://0.0.0.0:7781

# The operator-signed grant for this node's key (JSON: grant, sig), issued
# outside this machine.
FL_GRANT=/etc/furcate-leaf/head.grant.json

# The enrolled leaf's id; any other leaf is refused.
FL_LEAF=CHANGE-ME
