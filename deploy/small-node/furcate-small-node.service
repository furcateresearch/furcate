[Unit]
Description=Furcate small processing node: verifies, logs and escalates what the micro processing nodes below it send
Documentation=https://github.com/furcateresearch/furcate
# Inert until the node has a configuration: without /etc/furcate/small-node.env
# the unit is skipped, not failed. Nothing enables it; the operator does, after
# writing the file (deploy/small-node/README.md).
ConditionPathExists=/etc/furcate/small-node.env
# The node signs with the board's firmware-held key through the signing
# broker, so the broker's socket is wanted first. There is no fallback signer:
# without the broker the program exits. What reaching the broker takes is
# listed in deploy/small-node/README.md ("Signing through the board's broker"):
# the socket, the account, the group and the one unit option that carries it.
Wants=furcate-fwcrypto-broker.socket
After=furcate-fwcrypto-broker.socket

[Service]
Type=simple
# SMALL_ARGS carries the directory, model, forward target and policy flags.
EnvironmentFile=/etc/furcate/small-node.env
ExecStart=/opt/tools/furcate-small serve --backend rpi-fw-crypto --state-dir /var/lib/furcate-small-node --listen unix:/run/furcate-small-node/ingest.sock $SMALL_ARGS
Restart=on-failure
RestartSec=5

# Two checks stand between this program and a signature, and both must hold:
#   1. the broker answers a peer by its uid (SO_PEERCRED): root or `furcate`,
#      and nobody else, group member or not ("peer not allowed");
#   2. the broker's socket, /run/furcate-os/fwcrypto.sock, is root:furcate-fwcrypto
#      mode 0660, so the process also needs that group ("Permission denied" on
#      connect, before the broker is asked anything).
# User= answers the first and SupplementaryGroups= the second. No other unit
# option is needed: the unit does not open /dev/vcio*, so there is no
# DeviceAllow= and PrivateDevices=true stays. A login shell as `furcate` has
# the uid and not the group, which is why running this program by hand fails
# where the service does not (README).
User=furcate
Group=furcate
SupplementaryGroups=furcate-fwcrypto
StateDirectory=furcate-small-node
StateDirectoryMode=0700
RuntimeDirectory=furcate-small-node
RuntimeDirectoryMode=0750
WorkingDirectory=/var/lib/furcate-small-node
UMask=0077

# No network: frames arrive and escalations leave on a unix socket or a file.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryMax=256M
TasksMax=64
StandardInput=null

[Install]
WantedBy=multi-user.target
