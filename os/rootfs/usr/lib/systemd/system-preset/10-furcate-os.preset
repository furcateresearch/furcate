# Furcate OS service defaults. Applied when the image is built and on any
# preset run on the device, so they are not lost to the distribution presets.
enable furcate-extension-select.service
enable furcate-firstboot.service
enable furcate-identity.service
enable furcate-os-selftest.service
enable systemd-networkd.service
enable systemd-networkd-wait-online.service
enable systemd-resolved.service
enable systemd-timesyncd.service
# sshd as a plain service from boot: its host keys are made by
# furcate-firstboot.service, which runs before it.
enable ssh.service
disable ssh.socket
# Wi-Fi and Bluetooth: iwd associates from known networks in /var/lib/iwd;
# networkd configures the link (25-wireless.network).
enable iwd.service
enable bluetooth.service
# The overlay ships with Furcate and starts only when the operator enables it.
disable furcate-wg.service
disable furcate-names.service
disable furcate-names-link.service
disable furcate-overlay-reflect.service
# Node health: power readings every 5 s; the journal upload starts only once
# node.conf names the controller (its ExecCondition), and follows node.conf.
enable furcate-power.timer
enable systemd-journal-upload.service
enable furcate-journal-upload-config.path
disable systemd-journal-remote.socket
disable systemd-journal-remote.service
# The firmware signing broker, by socket.
enable furcate-fwcrypto-broker.socket
# nftables is mechanism only: Furcate loads the ruleset, not this service.
disable nftables.service
