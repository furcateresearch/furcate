#!/usr/bin/python3
"""Wi-Fi networks for iwd.

    furcate-os wifi add SSID < passphrase   add or replace a network
    furcate-os wifi list                    known networks (no secrets)
    furcate-os wifi remove SSID             forget a network

add reads the passphrase on stdin, never from the command line, and writes
/var/lib/iwd/<name>.psk, root 0600, holding only the pre-shared key derived
for THIS SSID (PBKDF2-HMAC-SHA1, 4096 rounds, the SSID as salt). A key
derived for one SSID does not work for another, even with the same
passphrase. iwd names a profile by the SSID when the SSID is only letters,
digits, '-', '_' and spaces; any other SSID (one with a '.', for example) is
"=" followed by its hex. iwd joins known networks by itself, preferring the
best one in range. The profiles live on the state partition.
"""
import hashlib
import os
import re
import subprocess
import sys

STATE = os.environ.get("FURCATE_IWD_STATE", "/var/lib/iwd")
SAFE = re.compile(rb"[A-Za-z0-9_ -]+")


def profile_name(ssid: bytes) -> str:
    """The file name iwd uses for an SSID, without the .psk suffix."""
    if SAFE.fullmatch(ssid):
        return ssid.decode("ascii")
    return "=" + ssid.hex()


def ssid_of(name: str) -> bytes:
    """The SSID a profile file name stands for."""
    if name.startswith("="):
        return bytes.fromhex(name[1:])
    return name.encode("ascii")


def psk_for(passphrase: bytes, ssid: bytes) -> str:
    return hashlib.pbkdf2_hmac("sha1", passphrase, ssid, 4096, 32).hex()


def read_passphrase() -> bytes:
    p = sys.stdin.buffer.read()
    if p.endswith(b"\r\n"):
        p = p[:-2]
    elif p.endswith(b"\n"):
        p = p[:-1]
    if not 8 <= len(p) <= 63:
        sys.exit("wifi: a WPA2 passphrase is 8 to 63 characters (read from stdin)")
    return p


def check_ssid(s: str) -> bytes:
    b = s.encode("utf-8")
    if not 1 <= len(b) <= 32:
        sys.exit("wifi: an SSID is 1 to 32 bytes")
    return b


def add(ssid_s: str) -> None:
    ssid = check_ssid(ssid_s)
    psk = psk_for(read_passphrase(), ssid)
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    path = os.path.join(STATE, profile_name(ssid) + ".psk")
    tmp = path + ".tmp"
    old = os.umask(0o077)
    try:
        with open(tmp, "w") as f:
            f.write("[Security]\nPreSharedKey=" + psk + "\n")
        os.chmod(tmp, 0o600)
        if os.geteuid() == 0:
            os.chown(tmp, 0, 0)
        os.replace(tmp, path)
    finally:
        os.umask(old)
    print(f"wifi: {ssid_s}: {path}")


def connected() -> dict:
    """SSID -> interface, for the networks iwd is connected to now."""
    out = {}
    try:
        devs = subprocess.run(["iwctl", "device", "list"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return out
    for ifc in re.findall(r"^\s+(wl\S+)\s", re.sub(r"\x1b\[[0-9;]*m", "", devs), re.M):
        show = subprocess.run(["iwctl", "station", ifc, "show"], capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"Connected network\s+(.+?)\s*$", re.sub(r"\x1b\[[0-9;]*m", "", show), re.M)
        if m:
            out[m.group(1)] = ifc
    return out


def list_() -> None:
    try:
        names = sorted(f[:-4] for f in os.listdir(STATE) if f.endswith(".psk"))
    except PermissionError:
        sys.exit("wifi: run as root to read the known networks")
    except FileNotFoundError:
        names = []
    if not names:
        print("wifi: no known networks")
        return
    now = connected()
    for n in names:
        ssid = ssid_of(n).decode("utf-8", "replace")
        st = os.stat(os.path.join(STATE, n + ".psk"))
        mode = "ok" if (st.st_mode & 0o077) == 0 and st.st_uid == 0 else "UNSAFE MODE/OWNER"
        where = f"connected on {now[ssid]}" if ssid in now else "known"
        print(f"{ssid}\t{where}\tfile {n}.psk ({oct(st.st_mode & 0o777)}, {mode})")


def remove(ssid_s: str) -> None:
    path = os.path.join(STATE, profile_name(check_ssid(ssid_s)) + ".psk")
    try:
        os.remove(path)
    except FileNotFoundError:
        sys.exit(f"wifi: no known network {ssid_s!r} ({path})")
    print(f"wifi: removed {ssid_s}")


def main() -> None:
    a = sys.argv[1:]
    if a[:1] == ["add"] and len(a) == 2:
        add(a[1])
    elif a == ["list"]:
        list_()
    elif a[:1] == ["remove"] and len(a) == 2:
        remove(a[1])
    else:
        sys.exit("usage: furcate-os wifi add SSID < passphrase | list | remove SSID")


if __name__ == "__main__":
    main()
