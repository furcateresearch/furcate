console=ttyAMA10,115200 console=tty1 root=PARTUUID=@STATE_PARTUUID@ rootfstype=ext4 rootwait rw mount.usr=/dev/mapper/usr mount.usrfstype=erofs mount.usrflags=ro usrhash=@USRHASH@ systemd.verity_usr_data=PARTUUID=@USR_PARTUUID@ systemd.verity_usr_hash=PARTUUID=@USRV_PARTUUID@ loglevel=2 panic=10 furcate.slot=@SLOT@
