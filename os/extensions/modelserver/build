#!/bin/sh
# Build the `modelserver` system extension: the inference runtime that
# `furcatectl model serve` and `furcatectl model gateway` run, for a board whose
# base does not carry it.
#
#   os/extensions/modelserver/build stage <base-usr-list> <out-dir> <version> <arch>
#   os/extensions/modelserver/build seal  <out-dir> <signature.b64>
#
# stage: the tree is exactly the `model` rows of deploy/release/manifest,
# assembled by deploy/release/install (which takes the runtime from
# deploy/runtimes.sh, pinned and digest-checked). <base-usr-list> is every path
# under /usr in the target base, one per line (`find /usr` on the device or on
# the image tree): every library the runtime needs must be in the base or in
# this tree, or the build refuses, so a runtime that cannot start is found here
# and not on the board. Run as root (systemd-repart 255 or newer).
#
# Then sign <out-dir>/roothash with os/release/sign-on and seal.
set -eu
export LC_ALL=C
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../../.." && pwd)
name=modelserver
cmd=${1:?usage: build stage|seal ...}
shift
case "$cmd" in
    seal) exec "$here/../sysext-image" seal "${1:?out-dir}" "$name" "${2:?signature.b64}" ;;
    stage) ;;
    *) echo "usage: build stage|seal ..." >&2; exit 2 ;;
esac
baselist=${1:?base-usr-list}; out=${2:?out-dir}; version=${3:?version}; arch=${4:?arch}
case "$arch" in
    arm64) rt=aarch64 ;;
    x86-64) rt=x86_64 ;;
    *) echo "arch must be arm64 or x86-64" >&2; exit 2 ;;
esac
[ -s "$baselist" ] || { echo "$baselist is empty or missing" >&2; exit 1; }
command -v readelf >/dev/null || { echo "missing readelf (binutils)" >&2; exit 1; }

work=$(mktemp -d "/var/tmp/furcate-$name.XXXXXX")
trap 'rm -rf "$work"' EXIT
tree="$work/tree"
mkdir -p "$tree" "$work/bins"

# 1. The tree, from the manifest. No binary of ours is in it, so the bin dir
# is empty.
FURCATE_RUNTIME_ARCH=$rt sh "$repo/deploy/release/install" model open "$work/bins" "$tree"
llama="$tree/usr/lib/furcate/runtimes/llama"
[ -x "$llama/llama-server" ] || { echo "no llama-server in the tree" >&2; exit 1; }
case "$arch:$(file -b "$llama/llama-server")" in
    arm64:*aarch64*|x86-64:*x86-64*) ;;
    *) echo "llama-server is not an $arch binary" >&2; exit 1 ;;
esac

# 2. Every library the server loads must be found on the board. The base's
# library directories, then the runtime's own (the unit sets LD_LIBRARY_PATH
# to it). A backend the runtime only opens on demand (the GPU one) is reported
# rather than required: without its loader that backend is absent, which
# `furcatectl model serve` states, and CPU serving remains the operator's
# explicit choice.
sort -u "$baselist" > "$work/base"
have() { # have <soname>
    [ -e "$llama/$1" ] && return 0
    grep -Fxq "/usr/lib/$rt-linux-gnu/$1" "$work/base" || grep -Fxq "/usr/lib/$1" "$work/base"
}
missing=0
for f in "$llama/llama-server" "$llama"/*.so*; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    for so in $(readelf -d "$f" 2>/dev/null | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p'); do
        have "$so" && continue
        case "$base" in
            libggml-vulkan.so*)
                echo "note: $base needs $so, which the base does not carry: GPU offload is unavailable on this base" ;;
            *)
                echo "MISSING: $base needs $so, which neither the base nor this extension carries" >&2
                missing=1 ;;
        esac
    done
done
[ "$missing" = 0 ] || { echo "refusing: the runtime could not start on this base" >&2; exit 1; }

# 3. The release file. No board key: the runtime is per architecture, not per
# board.
rel="$tree/usr/lib/extension-release.d/extension-release.$name"
install -d "$(dirname "$rel")"
cat > "$rel" <<EOF
ID=_any
ARCHITECTURE=$arch
EXTENSION_RELOAD_MANAGER=1
FURCATE_REQUIRES_ABI=1
FURCATE_VERSION=$version
EOF

"$here/../sysext-image" image "$tree" "$name" "$out" "$version" "$arch"
cp "$llama/VERSION" "$out/$name.runtime"
echo "$name: $(cat "$llama/VERSION"), $(du -sh "$llama" | cut -f1)"
